<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detail Produk - <%= product.name %></title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; background-color: #f9f9f9; }
    .container { max-width: 700px; margin: 40px auto; background: #fff; padding: 30px; border-radius: 8px; box-shadow: 0 2px 6px rgba(0,0,0,0.1); }
    .badge-category { display: inline-block; background-color: #e9ecef; color: #495057; padding: 5px 12px; border-radius: 20px; font-size: 0.85em; font-weight: bold; }
    h1 { margin: 15px 0 10px; color: #333; }
    .price { font-size: 1.6em; color: #28a745; font-weight: bold; margin: 15px 0; }
    .meta-info { font-size: 0.9em; color: #777; margin-bottom: 20px; border-bottom: 1px solid #eee; padding-bottom: 15px; }
    .description { line-height: 1.6; color: #444; margin-bottom: 30px; }
    .action-area { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; border-top: 1px solid #eee; padding-top: 20px; }
    .btn { padding: 10px 18px; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; font-size: 0.95em; text-align: center; }
    .btn-secondary { background-color: #6c757d; color: white; }
    .btn-success { background-color: #28a745; color: white; }
    .btn-warning { background-color: #ffc107; color: black; }
    .btn-danger { background-color: #dc3545; color: white; }
    .cart-form { display: flex; gap: 8px; align-items: center; margin-left: auto; }
    input[type="number"] { width: 65px; padding: 9px; border: 1px solid #ccc; border-radius: 4px; }
  </style>
</head>
<body>

  <div class="container">
    <span class="badge-category">
      <%= product.Category ? product.Category.name : 'Uncategorized' %>
    </span>

    <h1><%= product.name %></h1>

    <div class="meta-info">
      Dijual oleh: <strong><%= product.User ? product.User.email : 'Admin Toko' %></strong>
    </div>

    <div class="price">
      <%= rupiah(product.price) %>
    </div>

    <div class="description">
      <h3>Deskripsi Produk</h3>
      <p><%= product.description %></p>
    </div>

    <div class="action-area">
      <a href="/products" class="btn btn-secondary">&larr; Kembali ke Katalog</a>

      <% if (session.role === 'Admin') { %>
        <div style="margin-left: auto; display: flex; gap: 10px;">
          <a href="/products/<%= product.id %>/edit" class="btn btn-warning">Edit Produk</a>
          <a href="/products/<%= product.id %>/delete" class="btn btn-danger" onclick="return confirm('Yakin ingin menghapus produk ini?')">Hapus Produk</a>
        </div>
      <% } else { %>
        <form action="/carts/<%= product.id %>/add" method="POST" class="cart-form">
          <label for="quantity" style="font-size: 0.9em; color: #555;">Jumlah:</label>
          <input type="number" id="quantity" name="quantity">
          <button type="submit" class="btn btn-success">🛒 Tambah ke Keranjang</button>
        </form>
      <% } %>
    </div>
  </div>

</body>
</html>