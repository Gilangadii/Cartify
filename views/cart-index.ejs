<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Keranjang Belanja - Cartify</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; background-color: #f4f7fb; color: #1c1e21; }
    .container { max-width: 900px; margin: 30px auto; background: #fff; padding: 30px; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border-bottom: 1px solid #eee; padding-bottom: 15px; }
    h1 { margin: 0; font-size: 1.6em; color: #1877f2; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 25px; }
    th, td { padding: 14px 12px; text-align: left; border-bottom: 1px solid #eee; }
    th { background-color: #f8f9fa; color: #555; font-size: 0.9em; text-transform: uppercase; }
    .text-right { text-align: right; }
    .text-center { text-align: center; }
    .total-section { display: flex; justify-content: flex-end; align-items: center; gap: 25px; padding-top: 15px; border-top: 2px solid #eee; }
    .grand-total { font-size: 1.4em; font-weight: bold; color: #28a745; }
    .btn { padding: 10px 18px; border: none; border-radius: 6px; cursor: pointer; text-decoration: none; font-size: 0.95em; font-weight: bold; display: inline-block; }
    .btn-secondary { background-color: #6c757d; color: white; }
    .btn-danger { background-color: #dc3545; color: white; padding: 6px 12px; font-size: 0.85em; }
    .btn-success { background-color: #28a745; color: white; padding: 12px 24px; font-size: 1.05em; }
    .empty-state { text-align: center; padding: 50px 20px; color: #666; }
  </style>
</head>
<body>

  <div class="container">
    <header>
      <h1>🛒 Keranjang Belanja</h1>
      <a href="/products" class="btn btn-secondary">&larr; Lanjut Belanja</a>
    </header>

    <% if (carts.length === 0) { %>
      <div class="empty-state">
        <h3>Keranjang belanja kamu masih kosong.</h3>
        <p>Yuk, jelajahi katalog produk dan tambahkan barang pilihanmu!</p>
        <a href="/products" class="btn btn-success" style="margin-top: 15px;">Lihat Katalog Produk</a>
      </div>
    <% } else { %>
      <% let grandTotal = 0; %>

      <table>
        <thead>
          <tr>
            <th>No</th>
            <th>Nama Produk</th>
            <th class="text-right">Harga Satuan</th>
            <th class="text-center">Jumlah</th>
            <th class="text-right">Subtotal</th>
            <th class="text-center">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% carts.forEach((item, index) => { %>
            <% 
              const subtotal = item.calculateSubtotal(); 
              grandTotal += subtotal; 
            %>
            <tr>
              <td><%= index + 1 %></td>
              <td><strong><%= item.Product.name %></strong></td>
              <td class="text-right"><%= rupiah(item.Product.price) %></td>
              <td class="text-center"><%= item.quantity %></td>
              <td class="text-right"><strong><%= rupiah(subtotal) %></strong></td>
              <td class="text-center">
                <a href="/carts/<%= item.userId %>/<%= item.productId %>/delete" class="btn btn-danger" onclick="return confirm('Hapus produk ini dari keranjang?')">Hapus</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <div class="total-section">
        <div>
          <span style="color: #666; font-size: 0.95em;">Total Belanja:</span>
          <div class="grand-total"><%= rupiah(grandTotal) %></div>
        </div>
        <a href="/carts/checkout" class="btn btn-success">Lanjut ke Checkout &rarr;</a>
      </div>
    <% } %>
  </div>

</body>
</html>